root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
# rustfmt emits a trailing newline unconditionally; `false` would put the editor and the formatter
# in permanent disagreement.
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

# IntelliJ
ij_visual_guides = none

[*.rs]
indent_size = 4
indent_style = space

[*.{yml,yaml}]
indent_size = 2